# Copy this file to ".env.local" and fill in the values from YOUR Firebase
# project (Firebase console > Project settings > Your apps > Web app).
# ".env.local" is git-ignored. Never commit real values or tokens.

# --- Firebase web app config -------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Firebase App Check ------------------------------------------------------
# reCAPTCHA v3 site key for App Check (Firebase console > App Check).
VITE_FIREBASE_APPCHECK_SITE_KEY=

# OPTIONAL, local development only:
# Set this to "true" on localhost to print an App Check debug token in the
# browser console, then register that token in
# Firebase console > App Check > Apps > Manage debug tokens.
# You may also paste a specific debug token UUID here instead of "true".
# NEVER commit a real debug token.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
